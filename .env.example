# cti-skills — example environment file
#
# Copy to `.env` (gitignored) and fill in the keys you have, or export these
# directly in your shell rc. Every key is OPTIONAL — the pack degrades
# gracefully and skills skip enrichments for which no key is configured.
#
# The canonical way to configure keys is `/cti-setup` inside Claude Code or
# `./scripts/setup.sh`, which merge into `.claude/settings.local.json`. This
# file documents the same variables for the env-var workflow.
#
# Every variable below is left empty so this file is safe to `cp` straight to
# `.env`. Comments are on their own lines (no inline `#`) so any dotenv loader
# — Docker --env-file, `export $(cat .env | xargs)`, python-dotenv — reads the
# values as genuinely empty until you fill them in.
#
# Source of truth: tools/REGISTRY.md

# --- First-party platform --------------------------------------------------
# Liberty91 — API Access in the platform user menu (Owner/Admin); the secret is
# shown once. l91_live_ for production, l91_test_ for development.
LIBERTY91_API_KEY=
# Optional — override only for a non-production host
# (default https://api.liberty91.com/api/v1)
LIBERTY91_API_URL=
# Optional HTTP(S) proxy for Liberty91 traffic (falls back to HTTPS_PROXY)
LIBERTY91_PROXY=

# --- Always-useful starter set (free signups) ------------------------------
# VirusTotal — free 500/day — virustotal.com → profile → API key
VIRUSTOTAL_API_KEY=
# AlienVault OTX — free 10k/hr — otx.alienvault.com → settings
OTX_API_KEY=
# URLScan.io — free 100/day — urlscan.io → user settings
URLSCAN_API_KEY=
# AbuseIPDB — free 1000/day — abuseipdb.com → account → API
ABUSEIPDB_API_KEY=

# --- IP-focused recon ------------------------------------------------------
# Shodan — free tier — account.shodan.io
SHODAN_API_KEY=
# GreyNoise — community tier — viz.greynoise.io → account
GREYNOISE_API_KEY=

# --- Deep host + certificate recon (tight free quota) ----------------------
# Censys — 250/month — accounts.censys.io → settings → personal-access-tokens
CENSYS_PAT=
# Legacy Censys auth — fill these instead of CENSYS_PAT if that's what you have
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- Internal correlation (your own MISP instance) -------------------------
# MISP base URL — e.g. https://misp.example.org
MISP_URL=
# MISP auth key — MISP → My Profile → Auth keys.
# MISP_API_KEY is canonical. The CLI also accepts the older MISP_KEY, so an
# existing setup keeps working, but prefer this name in new configuration.
MISP_API_KEY=
# Optional HTTP(S) proxy for MISP traffic (falls back to HTTPS_PROXY)
MISP_PROXY=

# --- Internal knowledge base (your own OpenCTI instance) --------------------
# OpenCTI base URL — e.g. https://opencti.example.org (no trailing slash)
OPENCTI_URL=
# OpenCTI API token — your OpenCTI profile → API access
OPENCTI_TOKEN=
# Optional HTTP(S) proxy for OpenCTI traffic (falls back to HTTPS_PROXY)
OPENCTI_PROXY=

# --- Ransomware leak-site intelligence -------------------------------------
# Ransomware.live — free PRO 3000/day — my.ransomware.live
RANSOMWARE_LIVE=

# --- ReversingLabs Spectra Analyze / A1000 (licensed) ----------------------
# Licensed Spectra Analyze account (ask your RL admin)
REVERSINGLABS_USER=
REVERSINGLABS_PASSWORD=
# Optional — defaults to https://a1000.reversinglabs.com
REVERSINGLABS_HOST=

# --- CrowdStrike Falcon Intelligence (licensed) ----------------------------
# Falcon console → Support and resources → API clients and keys.
# Assign the Intel read scopes: Indicators / Actors / Reports (+ Rules if used).
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
# Optional cloud-region override — default https://api.crowdstrike.com (US-1).
#   US-2:     https://api.us-2.crowdstrike.com
#   EU-1:     https://api.eu-1.crowdstrike.com
#   GovCloud: https://api.laggar.gcw.crowdstrike.com
CROWDSTRIKE_BASE_URL=

# --- Dark-web collection (/darkweb-collection) -----------------------------
# Telegram channel monitoring. api_id and api_hash come from my.telegram.org →
# API development tools. TELEGRAM_SESSION is produced on first login and lets
# later runs reconnect without re-authenticating; leave it empty initially.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Account phone number in full international format, e.g. +971500000000
TELEGRAM_PHONE=
TELEGRAM_SESSION=
# Intelligence X — onion index search — intelx.io → account → API
INTELX_API_KEY=
